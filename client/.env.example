# CARTO Basemaps raster tiles. The `key` parameter is required since CARTO
# began metering the raster service — without it every tile is watermarked.
# Request one at https://carto.com/basemaps/apikey (free, no account needed).
# Never commit the real key: put it in .env, which is gitignored.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=YOUR_KEY

